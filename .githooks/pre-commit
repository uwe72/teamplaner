#!/usr/bin/env bash
#
# Auto-bump patch version on every commit.
# Single source of truth: gassi-frontend/package.json
# The same version is mirrored into gassi-backend/pom.xml (project version only).
#
set -e

PKG="gassi-frontend/package.json"
POM="gassi-backend/pom.xml"

current=$(grep -m1 '"version"' "$PKG" | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')

if ! echo "$current" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "pre-commit: could not detect a valid version in $PKG - skipping version bump." >&2
  exit 0
fi

IFS='.' read -r major minor patch <<< "$current"
new="$major.$minor.$((patch + 1))"

sed -i -E "0,/\"version\"[[:space:]]*:[[:space:]]*\"[0-9]+\.[0-9]+\.[0-9]+\"/s//\"version\": \"$new\"/" "$PKG"

awk -v newver="$new" '
  /<artifactId>gassi-backend<\/artifactId>/ { seen = 1 }
  seen && /<version>[0-9]+\.[0-9]+\.[0-9]+<\/version>/ {
    sub(/<version>[0-9]+\.[0-9]+\.[0-9]+<\/version>/, "<version>" newver "</version>")
    seen = 0
  }
  { print }
' "$POM" > "$POM.tmp" && mv "$POM.tmp" "$POM"

git add "$PKG" "$POM"

echo "pre-commit: version bumped $current -> $new"
